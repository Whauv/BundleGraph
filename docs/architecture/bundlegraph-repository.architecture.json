  "cards": [
    {
      "dot": "emerald",
      "title": "Authoritative journey",
      "items": [
        "AI extraction produces a draft; it cannot confirm requirements or approve a plan.",
        "Compatibility and selection are deterministic, evidence-backed, and block on required unknowns.",
        "Member 2 persists the chosen proposal, evidence, exact-version approval, and recovery versions."
      ]
    },
    {
      "dot": "amber",
      "title": "Current runtime status",
      "items": [
        "Application mode uses PostgreSQL and authentication but keeps PayPal disabled.",
        "Production mode intentionally refuses startup until PayPal Orders and webhook verification are composed.",
        "The PayPal sandbox Orders client is currently exercised through an explicit smoke workflow."
      ]
    },
    {
      "dot": "cyan",
      "title": "Optional provider boundaries",
      "items": [
        "Groq output is schema-validated before a draft is stored.",
        "Channel3 discovery enriches candidates without replacing deterministic selection.",
        "Elastic, KERNEL, and Astropods remain optional capabilities and fail closed when unconfigured."
      ]
    }
  ]
