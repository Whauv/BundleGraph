# Server-side configuration only. Leave all secret values empty in source control.
# Use demo for offline fixtures. Hosted authoritative/production deployments use
# Auth0/OIDC public configuration plus server-side JWT validation.
BUNDLEGRAPH_MODE=demo
# Optional controlled authoritative dry run: SHA-256 token hash -> subject/roles.
# Not required in demo mode. Store real JSON as a deployment secret.
BUNDLEGRAPH_AUTH_IDENTITIES=
# Auth0/OIDC JWT validation. These are public identifiers except where noted;
# no browser or JWT validation secret is required for an RS256 SPA/API setup.
BUNDLEGRAPH_OIDC_ISSUER=
BUNDLEGRAPH_OIDC_BROWSER_CLIENT_ID=
BUNDLEGRAPH_OIDC_AUDIENCE=
BUNDLEGRAPH_OIDC_SCOPE=openid profile email payments:execute
# Alternative provider integration: confidential RFC 7662 introspection.
BUNDLEGRAPH_OIDC_INTROSPECTION_URL=
BUNDLEGRAPH_OIDC_CLIENT_ID=
BUNDLEGRAPH_OIDC_CLIENT_SECRET=
# Allowlisted merchant references must match the active normalized catalog.
# The supplied synthetic fixture catalog uses synthetic-merchant.
BUNDLEGRAPH_SANDBOX_RECIPIENTS=synthetic-merchant
# Explicit comma-separated browser origins; never use '*'.
BUNDLEGRAPH_FRONTEND_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Public HTTPS base URL the browser payment journey returns to. Set only when the
# production app is reachable over the internet (ngrok, Cloud Run, Fly, etc.).
BUNDLEGRAPH_PUBLIC_BASE_URL=
# Opt-in sandbox test only; set after approving an order produced by paypal_smoke.
PAYPAL_APPROVED_ORDER_ID=
BUNDLEGRAPH_RUN_PAYPAL_SMOKE=0
CHANNEL3_API_KEY=
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
KERNEL_API_KEY=
ASTROPODS_API_KEY=
# Optional live requirements extraction. Keep the key server-side; model IDs are
# selected from Groq's currently supported catalog and are never sent by the browser.
GROQ_API_KEY=
GROQ_MODEL=
