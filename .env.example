# Server-side configuration only. Leave all values empty in source control.
BUNDLEGRAPH_MODE=demo
# SHA-256 token hash -> subject/roles map. Store the real JSON as a secret.
BUNDLEGRAPH_AUTH_IDENTITIES=
# Production identity-provider alternative: RFC 7662 token introspection.
BUNDLEGRAPH_OIDC_INTROSPECTION_URL=
BUNDLEGRAPH_OIDC_CLIENT_ID=
BUNDLEGRAPH_OIDC_CLIENT_SECRET=
BUNDLEGRAPH_OIDC_AUDIENCE=
BUNDLEGRAPH_SANDBOX_RECIPIENTS=
# Explicit comma-separated browser origins; never use '*'.
BUNDLEGRAPH_FRONTEND_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Public HTTPS base URL the browser payment journey returns to. Set only when the
# production app is reachable over the internet (ngrok, Cloud Run, Fly, etc.).
BUNDLEGRAPH_PUBLIC_BASE_URL=
# Opt-in sandbox test only; set after approving an order produced by paypal_smoke.
PAYPAL_APPROVED_ORDER_ID=
BUNDLEGRAPH_RUN_PAYPAL_SMOKE=0
CHANNEL3_API_KEY=
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
KERNEL_API_KEY=
ASTROPODS_API_KEY=
# Optional live requirements extraction. Keep the key server-side; model IDs are
# selected from Groq's currently supported catalog and are never sent by the browser.
GROQ_API_KEY=
GROQ_MODEL=
