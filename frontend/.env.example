# Public browser configuration. Leave runtime=fixture for explicit offline mode.
VITE_BUNDLEGRAPH_RUNTIME=fixture
# Empty uses the current origin in authoritative mode.
VITE_BUNDLEGRAPH_API_BASE=
# Bounded browser request timeout (250-60000 ms). Writes are never auto-retried.
VITE_BUNDLEGRAPH_REQUEST_TIMEOUT_MS=15000
VITE_BUNDLEGRAPH_OIDC_AUTHORIZATION_ENDPOINT=
VITE_BUNDLEGRAPH_OIDC_TOKEN_ENDPOINT=
VITE_BUNDLEGRAPH_OIDC_CLIENT_ID=
VITE_BUNDLEGRAPH_OIDC_SCOPE=openid profile
VITE_BUNDLEGRAPH_OIDC_REDIRECT_URI=
# Optional error collector. Only redacted event metadata is sent.
VITE_BUNDLEGRAPH_OBSERVABILITY_ENDPOINT=
